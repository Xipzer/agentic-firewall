{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-firewall.dev/afp/0.1/common.schema.json",
  "title": "AFP 0.1 shared definitions",
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["afp", "type", "id", "ts", "source"],
      "properties": {
        "afp": { "const": "0.1" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ts": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "source": {
      "type": "object",
      "required": ["tier", "agent"],
      "properties": {
        "tier": { "enum": ["dataplane", "fast", "medium", "slow", "human", "peer"] },
        "agent": { "type": "string", "minLength": 1 },
        "node": { "type": "string" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["host", "prefix", "flow"] },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "action": { "enum": ["allow", "observe", "throttle", "drop", "reroute", "quarantine"] },
    "ttl": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m|h|d)$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "signal": {
      "type": "object",
      "required": ["name", "weight"],
      "properties": {
        "name": { "type": "string" },
        "weight": { "type": "number" },
        "spoofable": { "type": "boolean" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
